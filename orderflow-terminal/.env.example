# OrderFlow Terminal — переменные окружения. Реальные значения секретов НЕ хранятся в репозитории:
# на Render они задаются во вкладке Environment сервиса (Secret), локально — в .env (в .gitignore).

# ---- сервер ----
PORT=8080
HOST=0.0.0.0
# локальный горячий кэш (на Render Free диск эфемерный: после перезапуска история берётся из Supabase)
DB_PATH=./data/orderflow.sqlite
# инструменты, которые пишутся постоянно (source:SYMBOL через запятую)
DEFAULT_SYMBOLS=bybit-linear:BTCUSDT,bybit-linear:ETHUSDT
MAX_SESSIONS=3
IDLE_STOP_MS=900000
BACKFILL_MINUTES=10

# ---- владелец (секрет) ----
# токен для изменяющих действий: paper, алерты, настройки, удаление истории, диагностика
OWNER_TOKEN=

# ---- Supabase (Postgres через пулер Supavisor, роль с минимальными правами oft_app) ----
SUPABASE_PROJECT_REF=
SUPABASE_REGION=eu-central-1
OFT_DB_USER=oft_app
# секрет
OFT_DB_PASSWORD=
# OFT_DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# OFT_DB_PORT=5432
# только для тестов/собственного Postgres: полный URL вместо пулера Supabase
# OFT_DB_URL=

# ---- архив L2-блоков (приватный bucket через Edge Function oft-archive) ----
# секрет; совпадает со значением в таблице oft.secrets (archive_key)
OFT_ARCHIVE_KEY=
# OFT_ARCHIVE_URL=https://<ref>.supabase.co/functions/v1/oft-archive
ARCHIVE_BLOCK_MS=300000
ARCHIVE_BAND=0.02
ARCHIVE_ENABLED=1

# ---- хранение и квоты (мс / байты) ----
RET_HEAT10_MS=172800000
RET_HEAT60_MS=2592000000
RET_EVENTS_MS=5184000000
RET_CANDLES_MS=31536000000
RET_ARCHIVE_MS=43200000
DB_BUDGET_BYTES=419430400
STORAGE_BUDGET_BYTES=891289600
# локальный кэш
HEAT_RAW_RETENTION_MS=7200000
HEAT_10S_RETENTION_MS=86400000
HEAT_60S_RETENTION_MS=604800000
TRADES_RETENTION_MS=21600000

# ---- адреса бирж (менять только при официальной смене URL; production отклоняет не-Binance хосты) ----
# BINANCE_FUTURES_REST=https://fapi.binance.com
# BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com   (маршруты /public и /market добавляются кодом)
# BINANCE_SPOT_REST=https://api.binance.com
# BINANCE_SPOT_WS=wss://stream.binance.com:9443/stream

# ---- Databento (платно; не включать без отдельного разрешения владельца) ----
# DATABENTO_API_KEY=
