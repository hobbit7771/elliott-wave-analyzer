# All optional. No API keys are needed: only public, free market-data endpoints are used.
PORT=8080
DB_PATH=./data/orderflow.sqlite
# instruments recorded continuously (comma separated source:SYMBOL)
DEFAULT_SYMBOLS=binance-futures:BTCUSDT
# max concurrently ingested instruments (each runs in its own worker thread)
MAX_SESSIONS=3
# stop an unpinned instrument after this long without viewers
IDLE_STOP_MS=900000
# minutes of aggTrades fetched via REST when an instrument starts (tick / 1s / footprint history)
BACKFILL_MINUTES=10
# retention (ms)
HEAT_RAW_RETENTION_MS=7200000
HEAT_10S_RETENTION_MS=86400000
HEAT_60S_RETENTION_MS=604800000
TRADES_RETENTION_MS=21600000
# Endpoint overrides (only for official Binance URL changes; production rejects non-Binance hosts)
# BINANCE_FUTURES_REST=https://fapi.binance.com
# BINANCE_FUTURES_WS=wss://fstream.binance.com/stream
# BINANCE_SPOT_REST=https://api.binance.com
# BINANCE_SPOT_WS=wss://stream.binance.com:9443/stream
