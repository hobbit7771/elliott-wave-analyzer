# T3 Elliott Wave Trading Engine - environment configuration.
# Copy to .env and fill in. All variables are read with the T3_ prefix
# (see t3_engine/config/settings.py).

# --- Exchange ---
T3_BINANCE_FUTURES_REST_BASE=https://fapi.binance.com
T3_BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com
# Testnet first: https://testnet.binancefuture.com
T3_BINANCE_API_KEY=
T3_BINANCE_API_SECRET=

# --- Symbols / historical load ---
T3_SYMBOLS=["BTCUSDT"]
T3_HISTORICAL_KLINES_LIMIT=1500

# --- Mode: PAPER | TESTNET | LIVE (only PAPER is exercised/tested in this build) ---
T3_TRADING_MODE=PAPER

# --- Risk management (fractions of equity) ---
T3_RISK_WAVE3=0.0100
T3_RISK_WAVE4=0.0050
T3_RISK_WAVE5=0.0075
T3_RISK_WAVE_C=0.0100
T3_MAX_DAILY_DRAWDOWN=0.03
T3_MAX_TOTAL_DRAWDOWN=0.12
T3_MAX_CONCURRENT_TRADES=3
T3_MAX_CORRELATED_EXPOSURE=0.02

# --- Signal engine ---
T3_ENTRY_CONFIDENCE_THRESHOLD=75.0

# --- Execution (paper simulation) ---
T3_TAKER_FEE_BPS=4.0
T3_SIMULATED_SLIPPAGE_BPS=2.0

# --- Storage / misc ---
# Default is a local SQLite file - zero setup. For production, point at
# Postgres/TimescaleDB, e.g.:
#   T3_DATABASE_URL=postgresql://user:pass@localhost:5432/t3_engine
T3_DATABASE_URL=sqlite:///./t3_engine.db
T3_LOG_DIR=./logs
T3_INITIAL_EQUITY=10000.0

# --- AI layer (OrcaRouter, optional) ---
# The API key is BYO and per-request from the dashboard, never read from
# here - only the endpoint is configurable server-side. Set this only if
# OrcaRouter's chat-completions path differs from the OpenAI-compatible
# default; the dashboard's AI tab can also override it per request.
T3_AI_API_BASE=https://orcarouter.ai/api/v1
