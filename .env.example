# T3 Elliott Wave Trading Engine - environment configuration.
# Copy to .env and fill in. All variables are read with the T3_ prefix
# (see t3_engine/config/settings.py).

# --- Exchange ---
T3_BINANCE_FUTURES_REST_BASE=https://fapi.binance.com
T3_BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com
# Testnet first: https://testnet.binancefuture.com
T3_BINANCE_API_KEY=
T3_BINANCE_API_SECRET=

# --- Symbols / historical load ---
T3_SYMBOLS=["BTCUSDT"]
T3_HISTORICAL_KLINES_LIMIT=1500

# --- Mode: PAPER | TESTNET | LIVE (only PAPER is exercised/tested in this build) ---
T3_TRADING_MODE=PAPER

# --- Risk management (fractions of equity) ---
T3_RISK_WAVE3=0.0100
T3_RISK_WAVE4=0.0050
T3_RISK_WAVE5=0.0075
T3_RISK_WAVE_C=0.0100
T3_MAX_DAILY_DRAWDOWN=0.03
T3_MAX_TOTAL_DRAWDOWN=0.12
T3_MAX_CONCURRENT_TRADES=3
T3_MAX_CORRELATED_EXPOSURE=0.02

# --- Signal engine ---
T3_ENTRY_CONFIDENCE_THRESHOLD=75.0

# --- Execution (paper simulation) ---
T3_TAKER_FEE_BPS=4.0
T3_SIMULATED_SLIPPAGE_BPS=2.0

# --- Storage / misc ---
# Default is a local SQLite file - zero setup. BEWARE on hosted deploys:
# the container filesystem is replaced on every deploy, so a SQLite file
# there loses every saved wave count and every journalled fill on the next
# push. /api/health reports which backend is in force.
#
# Two durable options, either of which is enough:
#
# 1. Supabase over its REST API. This is the one that works on a free
#    Supabase project: the database PASSWORD is shown exactly once at
#    creation and never again, and a new project's direct host is
#    IPv6-only (unreachable from Render), while the service key is always
#    retrievable and PostgREST answers over IPv4 HTTPS. Apply the schema
#    once (database/schema.sql or SQLAlchemy's create_all) and set:
#      T3_SUPABASE_URL=https://<project-ref>.supabase.co
#      T3_SUPABASE_SECRET_KEY=sb_secret_...      # service role - NOT the
#                                                # publishable key
#
# 2. Any Postgres URL. `postgres://` and `postgresql://` are both accepted
#    and rewritten to the psycopg driver, e.g.:
#      T3_DATABASE_URL=postgresql://user:pass@localhost:5432/t3_engine
T3_DATABASE_URL=sqlite:///./t3_engine.db
T3_LOG_DIR=./logs
T3_INITIAL_EQUITY=10000.0

# --- AI layer (OpenRouter, optional) ---
T3_AI_API_BASE=https://openrouter.ai/api/v1
# One id, or several comma-separated: the router uses the first that answers.
T3_AI_MODEL=~openai/gpt-astra-latest

# A server-side key, so the dashboard works without pasting one into the
# browser. NOTE: this dashboard has no login, so a key set here is usable
# by anyone who can open the page - it makes the app an open proxy to
# whoever owns the key. A per-browser key (the AI tab field) does not have
# that property, and a key sent with a request always wins over this one.
# Never commit a real value: a secret in a repo stays in its history.
T3_AI_API_KEY=

# kumo-relational lives on a DIFFERENT host from the chat models, though it
# takes the same key. Only override this if NVIDIA moves the endpoint.
T3_RELATIONAL_API_URL=https://ai.api.nvidia.com/v1/structured-data/nvidia/kumo-relational/predictions
